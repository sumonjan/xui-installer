#!/bin/bash
# ============================================================
#   X-UI Panel Management Script
#   Manage: Start/Stop/Restart/Status/Backup/Update
# ============================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

show_menu() {
    clear
    echo -e "${CYAN}"
    echo "╔══════════════════════════════════════════════════════╗"
    echo "║         X-UI Panel Management Menu                  ║"
    echo "╠══════════════════════════════════════════════════════╣"
    echo "║  [1] Panel চালু করুন (Start)                        ║"
    echo "║  [2] Panel বন্ধ করুন (Stop)                         ║"
    echo "║  [3] Panel রিস্টার্ট করুন (Restart)                ║"
    echo "║  [4] Panel স্ট্যাটাস দেখুন (Status)                ║"
    echo "║  [5] Panel আপডেট করুন (Update)                     ║"
    echo "║  [6] Panel আনইনস্টল করুন (Uninstall)               ║"
    echo "║  [7] ব্যাকআপ নিন (Backup)                          ║"
    echo "║  [8] ব্যাকআপ রিস্টোর করুন (Restore)               ║"
    echo "║  [9] ইনবাউন্ড পরিসংখ্যান (Statistics)              ║"
    echo "║  [10] সিস্টেম অপটিমাইজ করুন (Optimize)            ║"
    echo "║  [11] পোর্ট পরিবর্তন করুন (Change Port)            ║"
    echo "║  [12] পাসওয়ার্ড পরিবর্তন করুন (Change Password)   ║"
    echo "║  [0] বাহির (Exit)                                   ║"
    echo "╚══════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

start_panel() {
    systemctl start x-ui
    echo -e "${GREEN}[OK] X-UI Panel চালু হয়েছে${NC}"
}

stop_panel() {
    systemctl stop x-ui
    echo -e "${YELLOW}[OK] X-UI Panel বন্ধ হয়েছে${NC}"
}

restart_panel() {
    systemctl restart x-ui
    echo -e "${GREEN}[OK] X-UI Panel রিস্টার্ট হয়েছে${NC}"
}

status_panel() {
    echo -e "${BLUE}=== X-UI Service Status ===${NC}"
    systemctl status x-ui --no-pager
    echo ""
    echo -e "${BLUE}=== নেটওয়ার্ক পোর্ট ===${NC}"
    ss -tlnp | grep -E "(xray|x-ui)" 2>/dev/null || netstat -tlnp | grep -E "(xray|x-ui)" 2>/dev/null
    echo ""
    echo -e "${BLUE}=== সিস্টেম রিসোর্স ===${NC}"
    echo "CPU Usage: $(top -bn1 | grep "Cpu(s)" | awk '{print $2}')%"
    echo "Memory: $(free -h | awk '/Mem/{print $3"/"$2}')"
    echo "Disk: $(df -h / | awk 'NR==2{print $3"/"$2" ("$5" used)"}')"
}

update_panel() {
    echo -e "${BLUE}[INFO] X-UI আপডেট করা হচ্ছে...${NC}"
    x-ui update 2>/dev/null || bash <(curl -Ls https://raw.githubusercontent.com/mhsanaei/3x-ui/master/install.sh)
    echo -e "${GREEN}[OK] আপডেট সম্পন্ন${NC}"
}

uninstall_panel() {
    echo -e "${RED}[WARN] আপনি কি সত্যিই আনইনস্টল করতে চান? (yes/no):${NC}"
    read -r CONFIRM
    if [[ $CONFIRM == "yes" ]]; then
        x-ui uninstall 2>/dev/null
        systemctl stop x-ui 2>/dev/null
        systemctl disable x-ui 2>/dev/null
        rm -rf /usr/local/x-ui
        rm -f /etc/systemd/system/x-ui.service
        systemctl daemon-reload
        echo -e "${GREEN}[OK] X-UI আনইনস্টল সম্পন্ন${NC}"
    fi
}

backup_panel() {
    BACKUP_DIR="/root/xui-backup"
    BACKUP_FILE="$BACKUP_DIR/xui-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    mkdir -p $BACKUP_DIR

    tar -czf $BACKUP_FILE \
        /etc/x-ui/ \
        /usr/local/x-ui/db/ \
        2>/dev/null

    if [[ -f $BACKUP_FILE ]]; then
        echo -e "${GREEN}[OK] ব্যাকআপ সংরক্ষিত: $BACKUP_FILE${NC}"
    else
        echo -e "${RED}[ERROR] ব্যাকআপ ব্যর্থ হয়েছে${NC}"
    fi
}

restore_panel() {
    echo -e "${YELLOW}ব্যাকআপ ফাইলের পথ লিখুন:${NC}"
    read -r BACKUP_FILE
    if [[ -f $BACKUP_FILE ]]; then
        systemctl stop x-ui
        tar -xzf $BACKUP_FILE -C /
        systemctl start x-ui
        echo -e "${GREEN}[OK] রিস্টোর সম্পন্ন${NC}"
    else
        echo -e "${RED}[ERROR] ফাইল পাওয়া যায়নি${NC}"
    fi
}

show_statistics() {
    echo -e "${BLUE}=== X-UI ইনবাউন্ড পরিসংখ্যান ===${NC}"
    x-ui status 2>/dev/null
    echo ""
    if [[ -f /usr/local/x-ui/db/x-ui.db ]]; then
        echo -e "${CYAN}Database: /usr/local/x-ui/db/x-ui.db${NC}"
        ls -lh /usr/local/x-ui/db/x-ui.db
    fi
}

optimize_system() {
    echo -e "${BLUE}[INFO] সিস্টেম অপটিমাইজ করা হচ্ছে...${NC}"
    sysctl -p /etc/sysctl.conf > /dev/null 2>&1
    # Enable BBR
    modprobe tcp_bbr 2>/dev/null
    echo "tcp_bbr" >> /etc/modules-load.d/modules.conf 2>/dev/null
    BBR_STATUS=$(sysctl net.ipv4.tcp_congestion_control 2>/dev/null)
    echo -e "${GREEN}[OK] $BBR_STATUS${NC}"
    echo -e "${GREEN}[OK] অপটিমাইজেশন সম্পন্ন${NC}"
}

change_port() {
    echo -e "${YELLOW}নতুন Panel পোর্ট লিখুন (1024-65535):${NC}"
    read -r NEW_PORT
    if [[ $NEW_PORT -ge 1024 && $NEW_PORT -le 65535 ]]; then
        x-ui setting -port $NEW_PORT 2>/dev/null
        systemctl restart x-ui
        # Update firewall
        ufw allow $NEW_PORT/tcp 2>/dev/null
        echo -e "${GREEN}[OK] পোর্ট পরিবর্তন হয়েছে: $NEW_PORT${NC}"
        SERVER_IP=$(curl -s ifconfig.me)
        echo -e "${CYAN}নতুন URL: http://$SERVER_IP:$NEW_PORT${NC}"
    else
        echo -e "${RED}[ERROR] অবৈধ পোর্ট নম্বর${NC}"
    fi
}

change_password() {
    echo -e "${YELLOW}নতুন ইউজারনেম লিখুন:${NC}"
    read -r NEW_USER
    echo -e "${YELLOW}নতুন পাসওয়ার্ড লিখুন:${NC}"
    read -rs NEW_PASS
    echo ""
    x-ui setting -username $NEW_USER -password $NEW_PASS 2>/dev/null
    systemctl restart x-ui
    echo -e "${GREEN}[OK] লগইন তথ্য আপডেট হয়েছে${NC}"
}

# Main
while true; do
    show_menu
    echo -e "${WHITE}আপনার পছন্দ লিখুন [0-12]:${NC}"
    read -r CHOICE

    case $CHOICE in
        1) start_panel ;;
        2) stop_panel ;;
        3) restart_panel ;;
        4) status_panel ;;
        5) update_panel ;;
        6) uninstall_panel ;;
        7) backup_panel ;;
        8) restore_panel ;;
        9) show_statistics ;;
        10) optimize_system ;;
        11) change_port ;;
        12) change_password ;;
        0) echo -e "${GREEN}ধন্যবাদ!${NC}"; exit 0 ;;
        *) echo -e "${RED}অবৈধ পছন্দ!${NC}" ;;
    esac

    echo -e "\n${YELLOW}এন্টার চাপুন মেনুতে ফিরে যেতে...${NC}"
    read -r
done

#!/bin/bash
# ================================================================
#   SSL Certificate Auto Setup — Let's Encrypt (Acme.sh)
# ================================================================

R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'
B='\033[0;34m'; C='\033[0;36m'; N='\033[0m'

ok()   { echo -e "${G}  [✔] $1${N}"; }
info() { echo -e "${B}  [•] $1${N}"; }
err()  { echo -e "${R}  [✘] $1${N}"; }

[[ $EUID -ne 0 ]] && err "Root হিসেবে চালান!" && exit 1

clear
echo -e "${C}"
echo "╔════════════════════════════════════════════════╗"
echo "║        SSL Certificate Auto Setup             ║"
echo "╚════════════════════════════════════════════════╝"
echo -e "${N}"

echo -e "${Y}আপনার ডোমেইন লিখুন (যেমন: vpn.example.com):${N}"
read -r DOMAIN
echo -e "${Y}আপনার Email লিখুন:${N}"
read -r EMAIL
echo -e "${Y}Panel পোর্ট (ডিফল্ট 2053):${N}"
read -r PORT; PORT=${PORT:-2053}

# Domain IP check
SERVER_IP=$(curl -s ifconfig.me)
DOMAIN_IP=$(dig +short "$DOMAIN" 2>/dev/null | head -1)
if [[ "$SERVER_IP" != "$DOMAIN_IP" ]]; then
    echo -e "${R}  [!] ডোমেইন IP ($DOMAIN_IP) ≠ সার্ভার IP ($SERVER_IP)${N}"
    echo -e "${Y}  DNS ঠিক করুন, তারপর আবার চালান।${N}"
    exit 1
fi

# Stop services on port 80
systemctl stop nginx 2>/dev/null
systemctl stop apache2 2>/dev/null

# Install acme.sh
info "Acme.sh ইনস্টল হচ্ছে..."
curl -Ls https://get.acme.sh | sh -s email="$EMAIL" >> /var/log/ssl-setup.log 2>&1
source ~/.bashrc
~/.acme.sh/acme.sh --set-default-ca --server letsencrypt >> /var/log/ssl-setup.log 2>&1

# Issue cert
info "SSL সার্টিফিকেট তৈরি হচ্ছে..."
mkdir -p /etc/x-ui/ssl

~/.acme.sh/acme.sh --issue --standalone -d "$DOMAIN" \
    --key-file   /etc/x-ui/ssl/private.key \
    --fullchain-file /etc/x-ui/ssl/fullchain.pem \
    --reloadcmd "systemctl restart x-ui" >> /var/log/ssl-setup.log 2>&1

if [[ $? -ne 0 ]]; then
    err "SSL তৈরি ব্যর্থ! লগ দেখুন: cat /var/log/ssl-setup.log"
    exit 1
fi

# Apply to x-ui
x-ui setting -certFile /etc/x-ui/ssl/fullchain.pem >> /dev/null 2>&1
x-ui setting -keyFile  /etc/x-ui/ssl/private.key   >> /dev/null 2>&1
systemctl restart x-ui
sleep 2

ok "SSL সার্টিফিকেট সফলভাবে প্রয়োগ হয়েছে!"
echo ""
echo -e "${G}  Panel: https://${DOMAIN}:${PORT}${N}"
echo -e "${C}  অটো-রিনিউ: ~/.acme.sh/acme.sh --cron${N}"
